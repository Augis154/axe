{
  "name": "moth-language",
  "displayName": "Moth Language",
  "description": "Syntax highlighting for the Moth language",
  "version": "0.0.1",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "moth",
      "aliases": ["Moth", "moth"],
      "extensions": [".mh"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "moth",
      "scopeName": "source.moth",
      "path": "./syntaxes/moth.tmLanguage.json"
    }]
  }
}
