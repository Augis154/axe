{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Moth",
  "scopeName": "source.moth",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#number"
    },
    {
      "include": "#func_decl"
    },
    {
      "include": "#pointer_type"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#func_call"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.moth",
      "match": "#.*$"
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.moth",
          "match": "\\\\(?:[nrt0\\\\'\"]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.moth",
          "match": "\\\\."
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.moth",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.moth",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.moth",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.moth",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.moth",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)f?\\b"
        },
        {
          "name": "constant.numeric.integer.moth",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "func_decl": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.function.moth"
        },
        "2": {
          "name": "entity.name.function.moth"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.moth",
          "match": "\\b(if|else|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.operator.cast.moth",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.type.moth",
          "match": "\\b(var|fn)\\b"
        },
        {
          "name": "constant.language.null.moth",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.undef.moth",
          "match": "\\bundef\\b"
        },
        {
          "name": "constant.language.boolean.moth",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "type": {
      "name": "support.type.primitive.moth",
      "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|bool|void)\\b"
    },
    "func_call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.moth"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.dereference.moth",
          "match": "\\.\\*"
        },
        {
          "name": "keyword.operator.logical.moth",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.bitwise.shift.moth",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.moth",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.moth",
          "match": "="
        },
        {
          "name": "keyword.operator.bitwise.moth",
          "match": "~|\\^|\\|"
        },
        {
          "name": "keyword.operator.bitwise.moth",
          "match": "(?<=[A-Za-z0-9_)\\]]|[A-Za-z0-9_)\\]] |\\.\\*|\\.\\* )(?<!return )&"
        },
        {
          "name": "keyword.operator.arithmetic.moth",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.address.moth",
          "match": "&"
        }
      ]
    },
    "pointer_type": {
      "patterns": [
        {
          "match": "(\\bas)(\\s+)((?:\\*|\\[[^\\]\\n]*\\])+)",
          "captures": {
            "1": {
              "name": "keyword.operator.cast.moth"
            },
            "3": {
              "name": "meta.type.prefix.moth",
              "patterns": [
                {
                  "begin": "\\[",
                  "end": "\\]",
                  "name": "meta.array.size.moth",
                  "beginCaptures": {
                    "0": {
                      "name": "punctuation.definition.array.moth"
                    }
                  },
                  "endCaptures": {
                    "0": {
                      "name": "punctuation.definition.array.moth"
                    }
                  },
                  "patterns": [
                    {
                      "include": "#number"
                    },
                    {
                      "include": "#operator"
                    }
                  ]
                },
                {
                  "match": "\\*+",
                  "name": "storage.modifier.pointer.moth"
                }
              ]
            }
          }
        },
        {
          "match": "(:)(\\s*)((?:\\*|\\[[^\\]\\n]*\\])+)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.moth"
            },
            "3": {
              "name": "meta.type.prefix.moth",
              "patterns": [
                {
                  "begin": "\\[",
                  "end": "\\]",
                  "name": "meta.array.size.moth",
                  "beginCaptures": {
                    "0": {
                      "name": "punctuation.definition.array.moth"
                    }
                  },
                  "endCaptures": {
                    "0": {
                      "name": "punctuation.definition.array.moth"
                    }
                  },
                  "patterns": [
                    {
                      "include": "#number"
                    },
                    {
                      "include": "#operator"
                    }
                  ]
                },
                {
                  "match": "\\*+",
                  "name": "storage.modifier.pointer.moth"
                }
              ]
            }
          }
        }
      ]
    },
    "brackets": {
      "match": "[\\[\\]]",
      "name": "punctuation.definition.array.moth"
    }
  }
}
